{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zawa356/vulnfolio/blob/main/contracts/collection-envelope-0.1.0.schema.json",
  "title": "vulnfolio M1 inventory import envelope 0.1.0",
  "description": "This is the inventory IMPORT subset. Nonempty scanner findings are not accepted by the current importer.",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "collector",
    "status",
    "observations",
    "findings",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "collector": {
      "type": "object",
      "required": [
        "driver"
      ],
      "properties": {
        "driver": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "observed_at": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "success",
        "partial_success",
        "failed",
        "empty"
      ]
    },
    "observations": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "os",
          "packages",
          "patches"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "os": {
            "type": "object",
            "properties": {
              "family": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 80
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "distribution": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 120
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "version": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 120
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "build": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 120
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "packages": {
            "type": "array",
            "maxItems": 2000,
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                },
                "version": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 120
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "epoch": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 60
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "release": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 120
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "arch": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 80
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "manager": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 80
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "patches": {
            "type": "array",
            "maxItems": 2000,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "inventory_scope": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 0
    },
    "errors": {
      "type": "array",
      "maxItems": 200
    }
  }
}
